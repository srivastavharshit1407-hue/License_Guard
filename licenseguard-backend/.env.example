# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Leave blank to use SQLite (fine for local dev)
DATABASE_URL=

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Credential encryption (REQUIRED) ----
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# ---- Google SSO (Sign in with Google) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Email (alerts) ----
# Dev: prints emails to the console. Prod: swap to SMTP or an API provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=LicenseGuard <alerts@licenseguard.local>

# ---- Celery (background sync + alert jobs) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- Connectors ----
# When True, connectors return realistic fake data so you can build the UI
# before you have real API credentials. Set to False once you connect real accounts.
CONNECTORS_DEMO_MODE=True
